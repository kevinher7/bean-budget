{
  "name": "bean-budget",
  "version": "0.0.0",
  "private": true,
  "description": "Personal budgeting with mobile and web apps, spending widgets, and email transaction imports",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --strict --severity error,warning",
    "lint": "npm run lint:oxlint && npm run lint:effect",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run typecheck && npm run check:boundaries && npm run check:ui-colors && npm run lint",
    "server": "tsx apps/server/src/main.ts",
    "dev:server": "bash tools/dev-server.sh",
    "check:boundaries": "node tools/check-boundaries.mts",
    "android:doctor": "bash tools/android.sh doctor",
    "android:setup": "bash tools/android.sh setup",
    "android:emulator": "bash tools/android.sh emulator",
    "up": "bash tools/compose.sh up --build --detach --wait",
    "down": "bash tools/compose.sh down",
    "logs": "bash tools/compose.sh logs --follow server",
    "android:build": "bash tools/android.sh build",
    "android:dev": "bash tools/android.sh dev",
    "check:ui-colors": "node tools/check-ui-colors.mts"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@shekohex/oxc-effect": "0.2.1",
    "@types/node": "22.20.5",
    "oxfmt": "0.77.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.22.3"
  },
  "packageManager": "npm@10.9.8"
}
