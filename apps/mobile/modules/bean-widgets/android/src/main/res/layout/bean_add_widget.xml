<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bean_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bean_widget_primary"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="4dp"
  android:contentDescription="@string/bean_widget_add_description">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="@string/bean_widget_plus"
    android:textColor="@color/bean_widget_on_primary"
    android:textSize="36sp"
    android:textStyle="bold" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:maxLines="1"
    android:text="@string/bean_widget_add"
    android:textColor="@color/bean_widget_on_primary"
    android:textSize="11sp" />
</LinearLayout>
