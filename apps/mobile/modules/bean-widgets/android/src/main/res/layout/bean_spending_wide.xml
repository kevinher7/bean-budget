<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bean_spending_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bean_spending_surface">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <TextView
      android:id="@+id/bean_spending_category"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="@string/bean_widget_choose"
      android:textColor="@color/bean_widget_text"
      android:textSize="13sp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textStyle="bold" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <LinearLayout
      android:id="@+id/bean_spending_today_row"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.125"
        android:text="@string/bean_widget_today"
        android:textColor="@color/bean_widget_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
      <LinearLayout
        android:id="@+id/bean_spending_today_bar"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal" />
      <TextView
        android:id="@+id/bean_spending_today_amount"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bean_widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <LinearLayout
      android:id="@+id/bean_spending_week_row"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.125"
        android:text="@string/bean_widget_week"
        android:textColor="@color/bean_widget_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
      <LinearLayout
        android:id="@+id/bean_spending_week_bar"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal" />
      <TextView
        android:id="@+id/bean_spending_week_amount"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bean_widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <TextView
      android:id="@+id/bean_spending_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="@color/bean_widget_secondary"
      android:textSize="10sp" />
  </LinearLayout>
</FrameLayout>
