<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bean_spending_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:paddingHorizontal="12dp"
  android:paddingVertical="3dp"
  android:background="@drawable/bean_spending_surface">
  <TextView
    android:id="@+id/bean_spending_heading"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/bean_widget_text"
    android:textStyle="bold"
    android:text="@string/bean_widget_choose" />
  <LinearLayout
    android:id="@+id/bean_spending_totals"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:visibility="gone">
    <TextView
      android:id="@+id/bean_spending_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:textSize="24sp"
      android:textColor="@color/bean_widget_text"
      android:textStyle="bold" />
    <FrameLayout
      android:layout_width="12dp"
      android:layout_height="1dp" />
    <TextView
      android:id="@+id/bean_spending_week"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:textSize="13sp"
      android:textColor="@color/bean_widget_secondary" />
  </LinearLayout>
  <TextView
    android:id="@+id/bean_spending_status"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:textSize="11sp"
    android:textColor="@color/bean_widget_secondary" />
</LinearLayout>
